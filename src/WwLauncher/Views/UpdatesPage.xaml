<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WwLauncher.Views.UpdatesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    NavigationCacheMode="Enabled">

    <ScrollViewer Padding="36,24,36,36">
        <StackPanel MaxWidth="840" Spacing="20" HorizontalAlignment="Left">

            <StackPanel Spacing="8">
                <TextBlock Text="更新" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock
                    Text="檢查遠端或本機更新清單。下載與套用流程尚未實作。"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Opacity="0.8"
                    TextWrapping="WrapWholeWords" />
            </StackPanel>

            <InfoBar
                x:Name="StatusBar"
                IsOpen="True"
                IsClosable="False"
                Severity="Informational"
                Title="就緒"
                Message="按下「檢查更新」開始比對版本。" />

            <Border
                Padding="20"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel Spacing="16">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="4" VerticalAlignment="Center">
                            <TextBlock Text="啟動器版本" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock x:Name="LocalVersionText" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.75" />
                        </StackPanel>
                        <Button
                            x:Name="CheckUpdateButton"
                            Grid.Column="1"
                            Content="檢查更新"
                            Style="{StaticResource AccentButtonStyle}"
                            Click="CheckUpdateButton_Click" />
                    </Grid>

                    <ProgressBar
                        x:Name="UpdateProgress"
                        Minimum="0"
                        Maximum="100"
                        Visibility="Collapsed"
                        IsIndeterminate="True" />

                    <TextBlock
                        x:Name="DetailText"
                        Style="{StaticResource BodyTextBlockStyle}"
                        TextWrapping="WrapWholeWords"
                        IsTextSelectionEnabled="True"
                        Opacity="0.9" />
                </StackPanel>
            </Border>

            <Expander
                Header="更新清單說明"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                IsExpanded="False">
                <TextBlock
                    Margin="0,8,0,0"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    TextWrapping="WrapWholeWords"
                    Opacity="0.85"
                    Text="本機：輸出目錄 update-manifest.sample.json。遠端：環境變數 WW_LAUNCHER_UPDATE_URL 指向 JSON（product / version / downloadUrl / sha256 / mandatory / releaseNotes）。" />
            </Expander>
        </StackPanel>
    </ScrollViewer>
</Page>
