<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WwLauncher.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Disabled">

    <ScrollViewer Padding="36,24,36,36">
        <StackPanel MaxWidth="880" Spacing="20" HorizontalAlignment="Left">

            <StackPanel Spacing="4">
                <TextBlock Text="設定" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock
                    Text="關於資訊、更新與遊戲路徑。"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Opacity="0.75" />
            </StackPanel>

            <!-- 關於 -->
            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid Padding="20" ColumnDefinitions="Auto,*" ColumnSpacing="20">
                    <Border
                        Width="72"
                        Height="72"
                        CornerRadius="12"
                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                        <Image
                            Source="ms-appx:///Assets/StoreLogo.png"
                            Stretch="Uniform"
                            Margin="10" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                        <TextBlock x:Name="AppNameText" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock x:Name="AuthorText" Style="{StaticResource BodyTextBlockStyle}" Opacity="0.85" />
                        <TextBlock x:Name="VersionText" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 應用行為：檢查更新（列表列樣式） -->
            <StackPanel Spacing="8">
                <TextBlock
                    Text="應用行為"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Margin="4,0,0,0" />

                <Border
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <Button
                        x:Name="CheckUpdateRow"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="16,14"
                        Click="CheckUpdateRow_Click">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                            <FontIcon
                                Glyph="&#xE895;"
                                FontSize="18"
                                VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="檢查更新" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock
                                    x:Name="UpdateStatusText"
                                    Text="點擊以檢查更新"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Opacity="0.7" />
                            </StackPanel>
                            <FontIcon
                                Grid.Column="2"
                                Glyph="&#xE76C;"
                                FontSize="12"
                                Opacity="0.55"
                                VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                </Border>
            </StackPanel>

            <!-- 設置相關：主題 -->
            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel>
                    <Grid Padding="16">
                        <StackPanel Spacing="2">
                            <TextBlock Text="設置相關" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock
                                Text="外觀與其他啟動器偏好。"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Opacity="0.75" />
                        </StackPanel>
                    </Grid>
                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    <StackPanel Padding="16" Spacing="12">
                        <RadioButtons
                            x:Name="ThemeRadioButtons"
                            Header="主題"
                            SelectionChanged="ThemeRadioButtons_SelectionChanged">
                            <RadioButton Content="跟隨系統" Tag="Default" />
                            <RadioButton Content="淺色" Tag="Light" />
                            <RadioButton Content="深色" Tag="Dark" />
                        </RadioButtons>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 遊戲路徑 -->
            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel>
                    <Grid Padding="16">
                        <StackPanel Spacing="2">
                            <TextBlock Text="遊戲路徑" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock
                                Text="指定遊戲主程式（.exe），之後啟動按鈕會使用此路徑。"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Opacity="0.75"
                                TextWrapping="WrapWholeWords" />
                        </StackPanel>
                    </Grid>
                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    <StackPanel Padding="16" Spacing="12">
                        <TextBox
                            x:Name="GamePathBox"
                            Header="路徑"
                            PlaceholderText="尚未設定，例如 D:\Games\Wuthering Waves\...\Client-Win64-Shipping.exe"
                            IsReadOnly="True" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="瀏覽…" Click="BrowseGamePath_Click" />
                            <Button Content="清除" Click="ClearGamePath_Click" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
