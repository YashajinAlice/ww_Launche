<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WwLauncher.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    NavigationCacheMode="Enabled">

    <ScrollViewer Padding="36,24,36,36">
        <StackPanel MaxWidth="840" Spacing="20" HorizontalAlignment="Left">

            <StackPanel Spacing="8">
                <TextBlock Text="設定" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock
                    Text="外觀與關於資訊。設定項目之後會再擴充。"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Opacity="0.8"
                    TextWrapping="WrapWholeWords" />
            </StackPanel>

            <!-- Theme — Gallery Settings 風格卡片列 -->
            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel>
                    <Grid Padding="16" ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="應用程式主題" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock
                                Text="選擇淺色、深色或跟隨系統（WinUI Gallery 設定頁同款）。"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Opacity="0.75"
                                TextWrapping="WrapWholeWords" />
                        </StackPanel>
                    </Grid>
                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    <StackPanel Padding="16" Spacing="8">
                        <RadioButtons
                            x:Name="ThemeRadioButtons"
                            Header="主題"
                            SelectedIndex="0"
                            SelectionChanged="ThemeRadioButtons_SelectionChanged">
                            <RadioButton Content="跟隨系統" Tag="Default" />
                            <RadioButton Content="淺色" Tag="Light" />
                            <RadioButton Content="深色" Tag="Dark" />
                        </RadioButtons>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel>
                    <Grid Padding="16">
                        <StackPanel Spacing="2">
                            <TextBlock Text="關於" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock
                                x:Name="AboutVersionText"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Opacity="0.75" />
                        </StackPanel>
                    </Grid>
                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    <StackPanel Padding="16" Spacing="6">
                        <TextBlock Style="{StaticResource BodyTextBlockStyle}" Text="技術棧：WinUI 3 + C#（Windows App SDK）" />
                        <TextBlock Style="{StaticResource BodyTextBlockStyle}" Text="封裝模式：Unpackaged" />
                        <TextBlock Style="{StaticResource BodyTextBlockStyle}" Text="UI 參考：WinUI 3 Gallery（Mica / TitleBar / NavigationView）" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
