<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WwLauncher.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:WwLauncher.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    NavigationCacheMode="Enabled">

    <Grid>
        <!-- 全幅氣氛背景（之後可換成角色立繪） -->
        <Grid x:Name="HeroBackground">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#FF1A1428" Offset="0" />
                    <GradientStop Color="#FF3D2A4A" Offset="0.45" />
                    <GradientStop Color="#FF1E3A4A" Offset="1" />
                </LinearGradientBrush>
            </Grid.Background>
            <Ellipse
                Width="720"
                Height="720"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Margin="0,0,-180,40"
                Opacity="0.35">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#88E8B86D" Offset="0" />
                        <GradientStop Color="#00000000" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse
                Width="520"
                Height="520"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,-80,-60,0"
                Opacity="0.25">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#6687CEEB" Offset="0" />
                        <GradientStop Color="#00000000" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <TextBlock
                Text="秧寶"
                FontSize="120"
                FontWeight="Bold"
                Opacity="0.08"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,48,120"
                IsHitTestVisible="False" />
        </Grid>

        <!-- 主內容：左欄資訊、右下 CTA -->
        <Grid Padding="28,20,28,28" ColumnDefinitions="400,*" RowDefinitions="*,Auto" ColumnSpacing="24">

            <StackPanel Grid.RowSpan="2" Spacing="14" VerticalAlignment="Stretch">

                <!-- 公告面板：輪播 + 分頁 + 列表（固定高度，最多 5 則） -->
                <Border
                    CornerRadius="10"
                    BorderThickness="1"
                    BorderBrush="#33FFFFFF"
                    Height="430"
                    VerticalAlignment="Top">
                    <Border.Background>
                        <AcrylicBrush
                            TintColor="#1A1A1A"
                            TintOpacity="0.55"
                            FallbackColor="#CC1A1A1A"
                            TintLuminosityOpacity="0.85" />
                    </Border.Background>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="180" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="190" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <FlipView
                            x:Name="BannerFlipView"
                            Background="Transparent"
                            BorderThickness="0"
                            CornerRadius="10,10,0,0">
                            <FlipView.ItemTemplate>
                                <DataTemplate x:DataType="models:AnnouncementItem">
                                    <Grid>
                                        <Border Background="#33000000">
                                            <Image
                                                Source="{x:Bind BannerUrl}"
                                                Stretch="UniformToFill"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center" />
                                        </Border>
                                        <Border
                                            VerticalAlignment="Bottom"
                                            Padding="14,10"
                                            Background="#99000000">
                                            <TextBlock
                                                Text="{x:Bind Title}"
                                                TextWrapping="NoWrap"
                                                TextTrimming="CharacterEllipsis"
                                                Foreground="White"
                                                FontWeight="SemiBold" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </FlipView.ItemTemplate>
                        </FlipView>

                        <SelectorBar
                            x:Name="AnnouncementCategoryBar"
                            Grid.Row="1"
                            Margin="8,4,8,0"
                            SelectionChanged="AnnouncementCategoryBar_SelectionChanged">
                            <SelectorBarItem Text="遊戲公告" IsSelected="True" Tag="game" />
                            <SelectorBarItem Text="作者公告" Tag="ours" />
                        </SelectorBar>

                        <Grid Grid.Row="2" Margin="4,0,4,4">
                            <ListView
                                x:Name="AnnouncementList"
                                SelectionMode="None"
                                IsItemClickEnabled="True"
                                ItemClick="AnnouncementList_ItemClick"
                                Background="Transparent"
                                ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                ScrollViewer.VerticalScrollMode="Disabled">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Padding" Value="10,6" />
                                        <Setter Property="MinHeight" Value="36" />
                                        <Setter Property="MaxHeight" Value="38" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:AnnouncementItem">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <TextBlock
                                                Text="{x:Bind ListTitle}"
                                                TextWrapping="NoWrap"
                                                TextTrimming="CharacterEllipsis"
                                                VerticalAlignment="Center" />
                                            <TextBlock
                                                Grid.Column="1"
                                                Text="{x:Bind PublishedShort}"
                                                Opacity="0.65"
                                                FontSize="12"
                                                VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <TextBlock
                                x:Name="EmptyAnnouncementsText"
                                Text="目前沒有公告。"
                                Visibility="Collapsed"
                                Opacity="0.7"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Grid>

                        <Grid Grid.Row="3" Padding="12,4,12,10" ColumnDefinitions="*,Auto">
                            <ProgressBar
                                x:Name="AnnouncementProgress"
                                IsIndeterminate="True"
                                Visibility="Collapsed"
                                VerticalAlignment="Center" />
                            <Button
                                x:Name="RefreshAnnouncementsButton"
                                Grid.Column="1"
                                Content="&#xE72C;"
                                FontFamily="Segoe Fluent Icons"
                                Width="36"
                                Height="32"
                                Padding="0"
                                ToolTipService.ToolTip="重新整理"
                                Click="RefreshAnnouncementsButton_Click" />
                        </Grid>
                    </Grid>
                </Border>

                <InfoBar
                    x:Name="AnnouncementStatusBar"
                    IsOpen="False"
                    IsClosable="True" />

                <!-- 數據終端摘要卡（占位，對齊官方啟動器左下） -->
                <Border
                    CornerRadius="10"
                    BorderThickness="1"
                    BorderBrush="#33FFFFFF"
                    Padding="14">
                    <Border.Background>
                        <AcrylicBrush
                            TintColor="#1A1A1A"
                            TintOpacity="0.55"
                            FallbackColor="#CC1A1A1A"
                            TintLuminosityOpacity="0.85" />
                    </Border.Background>

                    <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock
                                x:Name="PlayerNameText"
                                Text="尚未登入"
                                Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <Button
                                Grid.Column="1"
                                Content="&#xE72C;"
                                FontFamily="Segoe Fluent Icons"
                                Width="32"
                                Height="28"
                                Padding="0"
                                ToolTipService.ToolTip="重新整理終端（尚未接線）"
                                IsEnabled="False" />
                        </Grid>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <TextBlock Opacity="0.9">
                                <Run Text="聯覺等級 " Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <Run x:Name="UnionLevelText" Text="—" />
                            </TextBlock>
                            <TextBlock Grid.Column="1" Opacity="0.9">
                                <Run Text="UID " Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <Run x:Name="UidText" Text="—" />
                            </TextBlock>
                        </Grid>

                        <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
                            <Border Background="#22FFFFFF" CornerRadius="6" Padding="8">
                                <StackPanel Spacing="2">
                                    <FontIcon Glyph="&#xE9D9;" FontSize="14" HorizontalAlignment="Left" />
                                    <TextBlock x:Name="Res1Text" Text="—/—" FontSize="12" />
                                    <TextBlock Text="體力" FontSize="11" Opacity="0.65" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Background="#22FFFFFF" CornerRadius="6" Padding="8">
                                <StackPanel Spacing="2">
                                    <FontIcon Glyph="&#xE8CB;" FontSize="14" HorizontalAlignment="Left" />
                                    <TextBlock x:Name="Res2Text" Text="—/—" FontSize="12" />
                                    <TextBlock Text="箱庭" FontSize="11" Opacity="0.65" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Background="#22FFFFFF" CornerRadius="6" Padding="8">
                                <StackPanel Spacing="2">
                                    <FontIcon Glyph="&#xE734;" FontSize="14" HorizontalAlignment="Left" />
                                    <TextBlock x:Name="Res3Text" Text="—/—" FontSize="12" />
                                    <TextBlock Text="活躍" FontSize="11" Opacity="0.65" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="3" Background="#22FFFFFF" CornerRadius="6" Padding="8">
                                <StackPanel Spacing="2">
                                    <FontIcon Glyph="&#xE8F1;" FontSize="14" HorizontalAlignment="Left" />
                                    <TextBlock x:Name="Res4Text" Text="—/—" FontSize="12" />
                                    <TextBlock Text="其他" FontSize="11" Opacity="0.65" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <TextBlock
                            x:Name="TerminalHintText"
                            Text="終端資料尚未接線，之後會接 bot terminal API。"
                            FontSize="11"
                            Opacity="0.55"
                            TextWrapping="WrapWholeWords" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- 右下：主操作 -->
            <StackPanel
                Grid.Column="1"
                Grid.Row="1"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Spacing="12">
                <Button
                    Width="52"
                    Height="52"
                    Padding="0"
                    CornerRadius="8"
                    ToolTipService.ToolTip="更多選項">
                    <FontIcon Glyph="&#xE700;" FontSize="18" />
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="檢查檔案（尚未接線）" IsEnabled="False" />
                            <MenuFlyoutItem
                                x:Name="OpenGameFolderMenuItem"
                                Text="開啟遊戲目錄"
                                Click="OpenGameFolderMenuItem_Click" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>

                <Button
                    x:Name="LaunchButton"
                    Content="啟動"
                    MinWidth="280"
                    Height="52"
                    FontSize="18"
                    FontWeight="SemiBold"
                    CornerRadius="8"
                    IsEnabled="False"
                    ToolTipService.ToolTip="遊戲路徑尚未設定"
                    Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>
        </Grid>

        <!-- 應用內公告詳情（不開外部瀏覽器） -->
        <Grid
            x:Name="DetailOverlay"
            Visibility="Collapsed"
            Canvas.ZIndex="100">
            <Border Background="#99000000" Tapped="DetailOverlayBackdrop_Tapped" />
            <Border
                Width="760"
                MaxWidth="900"
                Height="560"
                MaxHeight="720"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                CornerRadius="12"
                BorderThickness="1"
                BorderBrush="#44FFFFFF"
                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                Padding="0">
                <Grid RowDefinitions="Auto,*,Auto">
                    <Grid Padding="16,12" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBlock
                            x:Name="DetailTitleText"
                            Style="{StaticResource SubtitleTextBlockStyle}"
                            TextWrapping="NoWrap"
                            TextTrimming="CharacterEllipsis"
                            VerticalAlignment="Center" />
                        <Button
                            Grid.Column="1"
                            Content="&#xE711;"
                            FontFamily="Segoe Fluent Icons"
                            Width="36"
                            Height="32"
                            Padding="0"
                            Click="CloseDetailButton_Click"
                            ToolTipService.ToolTip="關閉" />
                    </Grid>

                    <Grid Grid.Row="1" Margin="12,0,12,0">
                        <ProgressRing
                            x:Name="DetailProgress"
                            Width="40"
                            Height="40"
                            IsActive="False"
                            Visibility="Collapsed"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                        <WebView2
                            x:Name="DetailWebView"
                            DefaultBackgroundColor="Transparent" />
                    </Grid>

                    <Border Grid.Row="2" Padding="12,8" BorderThickness="0,1,0,0"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                        <TextBlock
                            x:Name="DetailStatusText"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Opacity="0.7"
                            Text="應用內預覽" />
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
