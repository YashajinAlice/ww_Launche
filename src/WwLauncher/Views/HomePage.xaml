<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WwLauncher.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    NavigationCacheMode="Enabled">

    <ScrollViewer Padding="36,24,36,36">
        <StackPanel MaxWidth="840" Spacing="20" HorizontalAlignment="Left">

            <!-- Gallery 風格頁首 -->
            <StackPanel Spacing="8">
                <TextBlock Text="首頁" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock
                    Text="WW Launcher 空骨架。之後在此接遊戲啟動與本機路徑設定。"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Opacity="0.8"
                    TextWrapping="WrapWholeWords" />
            </StackPanel>

            <!-- Hero card -->
            <Border
                Padding="24"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24">
                    <StackPanel Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="WW Launcher" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock x:Name="VersionText" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.75" />
                        <TextBlock
                            Text="目前尚未綁定遊戲可執行檔。啟動按鈕先保留為占位。"
                            Style="{StaticResource BodyTextBlockStyle}"
                            TextWrapping="WrapWholeWords"
                            Opacity="0.85" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center" MinWidth="160">
                        <Button
                            x:Name="LaunchButton"
                            Content="啟動"
                            Style="{StaticResource AccentButtonStyle}"
                            HorizontalAlignment="Stretch"
                            IsEnabled="False"
                            ToolTipService.ToolTip="尚未接線" />
                        <Button
                            Content="檢查更新"
                            HorizontalAlignment="Stretch"
                            Click="GoUpdates_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Info tiles -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <Border
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel Spacing="6">
                        <FontIcon Glyph="&#xE895;" HorizontalAlignment="Left" FontSize="20" />
                        <TextBlock Text="版本更新" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock
                            Text="支援本機 sample manifest 與遠端 WW_LAUNCHER_UPDATE_URL。"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            TextWrapping="WrapWholeWords"
                            Opacity="0.8" />
                    </StackPanel>
                </Border>

                <Border
                    Grid.Column="1"
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel Spacing="6">
                        <FontIcon Glyph="&#xE713;" HorizontalAlignment="Left" FontSize="20" />
                        <TextBlock Text="外觀" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock
                            Text="Mica 背景與 TitleBar / NavigationView，參考 WinUI 3 Gallery。"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            TextWrapping="WrapWholeWords"
                            Opacity="0.8" />
                    </StackPanel>
                </Border>
            </Grid>

            <InfoBar
                IsOpen="True"
                IsClosable="True"
                Severity="Informational"
                Title="開發中"
                Message="這是第一版 UI 骨架，之後可再對齊 Gallery 細節與實際啟動流程。" />
        </StackPanel>
    </ScrollViewer>
</Page>
