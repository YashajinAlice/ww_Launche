<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WwLauncher.Views.DataTerminalPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Enabled">

    <ScrollViewer Padding="36,24,36,36">
        <StackPanel MaxWidth="960" Spacing="20" HorizontalAlignment="Left">
            <StackPanel Spacing="8">
                <TextBlock Text="數據終端" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock
                    Text="欄位骨架：對齊 bot /api/user/terminal-* 系列。"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Opacity="0.8"
                    TextWrapping="WrapWholeWords" />
            </StackPanel>

            <Border Padding="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                <StackPanel Spacing="12">
                    <TextBlock Text="帳號" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBox Header="登入狀態" IsReadOnly="True" PlaceholderText="未登入" />
                    <TextBox Header="目前 UID" IsReadOnly="True" PlaceholderText="—" />
                    <ComboBox Header="切換 UID" HorizontalAlignment="Stretch" PlaceholderText="綁定列表" IsEnabled="False" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="登入" Style="{StaticResource AccentButtonStyle}" IsEnabled="False" />
                        <Button Content="重新整理終端資料" IsEnabled="False" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Padding="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                <StackPanel Spacing="12">
                    <TextBlock Text="終端資料" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12" RowDefinitions="Auto,Auto" RowSpacing="12">
                        <TextBox Header="活躍度 / 能量" IsReadOnly="True" PlaceholderText="—" />
                        <TextBox Grid.Column="1" Header="箱子進度" IsReadOnly="True" PlaceholderText="—" />
                        <TextBox Grid.Row="1" Header="世界等級" IsReadOnly="True" PlaceholderText="—" />
                        <TextBox Grid.Row="1" Grid.Column="1" Header="聯覺等級" IsReadOnly="True" PlaceholderText="—" />
                    </Grid>
                    <TextBox Header="角色清單摘要" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="100" PlaceholderText="尚未載入 resonators" />
                    <TextBox Header="原始 JSON 預覽" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="120" FontFamily="Consolas" PlaceholderText="—" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
